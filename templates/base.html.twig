<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Go Figure{% endblock %}</title>
        <meta name="description" content="{{ 'site.description'|trans }}">
        <link rel="icon" href="/favicon.svg" type="image/svg+xml">
        <link rel="stylesheet" href="/app.css">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            <script src="/proof.js" defer></script>
            <script src="/attack.js" defer></script>
            <script src="/copy.js" defer></script>
        {% endblock %}

    </head>
    <body data-proof-reading="{{ 'proof.panel.reading'|trans }}" data-proof-open="{{ 'proof.panel.open'|trans }}" data-proof-close="{{ 'proof.panel.close'|trans }}" data-proof-label="{{ 'proof.panel.label'|trans }}" data-attack-close="{{ 'Close'|trans }}" data-attack-lead="{{ 'attack.here'|trans }}">
        {% block header %}{{ include('_site.html.twig') }}{% endblock %}
        {% block body %}{% endblock %}
    </body>
</html>
