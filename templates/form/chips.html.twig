{#- The choices of the composer as buttons to tick: places in groups (countries, cities), the
    month in a row. Native checkboxes and radios underneath: the form works without JavaScript and
    with a keyboard. -#}

{% block _places_row %}
    {#- What Symfony's own row tells assistive technologies: the help, the errors. -#}
    {%- set described = [] -%}
    {%- if help %}{% set described = described|merge([id ~ '_help']) %}{% endif -%}
    {%- if errors|length > 0 %}{% set described = described|merge(errors|map((_, index) => id ~ '_error' ~ (index + 1))) %}{% endif -%}
    <fieldset class="gf-field"{% if described is not empty %} aria-describedby="{{ described|join(' ') }}"{% endif %}{% if errors|length > 0 %} aria-invalid="true"{% endif %}>
        <legend>{{ label|trans(label_translation_parameters, translation_domain) }}</legend>
        {{ form_errors(form) }}
        {{ form_widget(form) }}
        {{ form_help(form) }}
    </fieldset>
{% endblock %}

{% block _month_row %}{{ block('_places_row') }}{% endblock %}

{% block _places_widget %}
    {#- The checkboxes by value, to place each one in its group. -#}
    {%- set byValue = {} -%}
    {%- for child in form %}{% set byValue = byValue|merge({('v' ~ child.vars.value): child}) %}{% endfor -%}
    <div {{ block('widget_container_attributes') }}>
        {%- if choices|filter(c => c is iterable) is not empty -%}
            {%- for group, options in choices -%}
                <div class="gf-chip-group" role="group" aria-labelledby="{{ id }}_group{{ loop.index }}">
                    <span class="gf-chip-group-label" id="{{ id }}_group{{ loop.index }}">{{ group|trans }}</span>
                    <div class="gf-chips">
                        {%- for option in options -%}
                            <label class="gf-chip">{{ form_widget(byValue['v' ~ option.value]) }}<span>{{ option.label }}</span></label>
                        {%- endfor -%}
                    </div>
                </div>
            {%- endfor -%}
        {%- else -%}
            <div class="gf-chips">
                {%- for option in choices -%}
                    <label class="gf-chip">{{ form_widget(byValue['v' ~ option.value]) }}<span>{{ option.label }}</span></label>
                {%- endfor -%}
            </div>
        {%- endif -%}
    </div>
{% endblock %}

{% block _month_widget %}
    <div {{ block('widget_container_attributes') }}>
        <div class="gf-chips">
            {%- for child in form -%}
                <label class="gf-chip">{{ form_widget(child) }}<span>{{ child.vars.label }}</span></label>
            {%- endfor -%}
        </div>
    </div>
{% endblock %}
