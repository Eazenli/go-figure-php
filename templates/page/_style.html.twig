{# The styles of a page fragment, shared by the whole page and by a page that streams in. Inside the
   site, the colors follow its light or dark scheme (public/app.css); in an MCP host, the defaults. #}
<style>
    /* The series colours, in a fixed order, validated together for colour vision deficiencies; the
       surface rings the dots. Light here, which MCP hosts get (their frame is white); the site's dark
       steps of the same hues are in public/app.css. */
    .gf-page { --gf-s1: #2a78d6; --gf-s2: #eb6834; --gf-s3: #1baf7a; --gf-s4: #eda100; --gf-s5: #e87ba4; --gf-s6: #008300; --gf-s7: #6250d6; --gf-s8: #e34948; --gf-surface: var(--background, #ffffff); --gf-grid: var(--line, #e5e5ea); }
    .gf-page { font-family: system-ui, sans-serif; line-height: 1.45; color: var(--text, #1d1d1f); }
    .gf-page .gf-title { font-size: 1.5rem; margin: 0 0 1rem; }
    .gf-page .gf-heading { font-size: 1.05rem; margin: 0 0 .5rem; }
    .gf-page section { margin: 0 0 1.5rem; }
    /* Figures and codes keep their own direction, whatever the text around them. */
    .gf-figure, .gf-code { unicode-bidi: isolate; }
    .gf-figure { color: inherit; font-variant-numeric: tabular-nums; text-decoration: underline dotted; text-underline-offset: 3px; }
    .gf-flag { margin-left: 1px; color: var(--muted, #6e6e73); }
    .gf-unit { color: var(--muted, #6e6e73); }
    /* The period of a whole chart, by its title; the country a city's row takes its figure from. */
    .gf-period { display: inline-block; margin-left: .4em; padding: 0 .55em; border: 1px solid var(--line, #e5e5ea); border-radius: 999px; color: var(--muted, #6e6e73); font-size: .82em; font-weight: 500; vertical-align: .08em; }
    .gf-stand-in { display: block; color: var(--muted, #6e6e73); font-size: .9em; }
    /* The same value in full, beside its rounded form. */
    .gf-exact { color: var(--muted, #6e6e73); font-size: .8em; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .gf-kpi .gf-exact { display: block; font-size: .85rem; }
    .gf-kpi .gf-figure { font-size: 2rem; font-weight: 600; text-decoration-thickness: 1px; font-variant-numeric: normal; }
    .gf-refusal { display: inline-block; border: 1px solid var(--refusal-line, #c4314b); border-radius: 4px; padding: 0 .4em; color: var(--refusal-text, #8e1b30); background: var(--refusal-background, #fdf0f2); font-size: .9em; }
    .gf-unsourced { color: var(--refusal-line, #c4314b); font-weight: 600; }
    /* In a title set in a serif of one weight, the refusal is set in the sans: no faked bold. */
    .gf-page .gf-title .gf-unsourced { font: 600 1rem/1.4 system-ui, sans-serif; letter-spacing: 0; }
    .gf-note .gf-unsourced { margin: 0 .3em; }
    /* The answer in words, first under the title: read before the charts. */
    .gf-title + .gf-note p { font-size: 1.25rem; line-height: 1.45; max-width: 46ch; }
    .gf-title + .gf-note .gf-cell { font-size: .8rem; }
    /* What the figures of a block count, under its title. */
    .gf-scope { margin: -.2rem 0 .7rem; max-width: 68ch; color: var(--muted, #6e6e73); font-size: .86rem; line-height: 1.4; }
    .gf-kpi .gf-scope { margin: .15rem 0 .4rem; }
    /* What the model tried, struck out, its number blanked. */
    .gf-struck { color: var(--muted, #6e6e73); text-decoration: line-through; text-decoration-color: var(--refusal-line, #c4314b); text-decoration-thickness: 2px; }
    /* The stamp of a block: what the server read for it. */
    .gf-verified { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .7rem; margin: .8rem 0 0; color: var(--muted, #6e6e73); font-size: .85rem; }
    .gf-stamp { display: inline-block; padding: .12rem .6rem; border: 2px solid currentColor; border-radius: 3px; outline: 1px solid currentColor; outline-offset: 2px; color: var(--accent, #5b47e0); font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; transform: rotate(-2deg); }
    @media (prefers-reduced-motion: no-preference) {
        .gf-stamp { animation: gf-stamp-land .35s .35s cubic-bezier(.2, 1.4, .4, 1) both; }
        .gf-verified-what { animation: gf-stamp-said .3s .6s both; }
    }
    @keyframes gf-stamp-land { from { opacity: 0; transform: rotate(-2deg) scale(1.7); } to { opacity: 1; transform: rotate(-2deg) scale(1); } }
    @keyframes gf-stamp-said { from { opacity: 0; } to { opacity: 1; } }
    .gf-bars { list-style: none; padding: 0; margin: 0; }
    /* The value column has a set minimum, so the bars of several charts end at the same place; values
       align on the right, so their digits line up. */
    .gf-bars { display: grid; grid-template-columns: minmax(0, 9rem) minmax(3rem, 1fr) minmax(12rem, max-content); gap: .4rem .6rem; align-items: center; }
    .gf-bars li { display: grid; grid-column: 1 / -1; grid-template-columns: subgrid; align-items: center; }
    .gf-bar { background: var(--gf-s1); height: 1.1rem; border-radius: 0 4px 4px 0; min-width: 2px; }
    .gf-bar-value { white-space: nowrap; text-align: right; }
    .gf-bars .gf-cell { color: var(--text, #1d1d1f); font-size: .875em; }
    .gf-bar-refused { grid-column: 2 / -1; min-width: 0; }
    @media (max-width: 34rem) {
        .gf-bars { grid-template-columns: minmax(3rem, 1fr) max-content; row-gap: .15rem; }
        /* On a phone a long unit wraps, the figure itself never does. */
        .gf-bar-value { white-space: normal; max-width: 12rem; }
        .gf-bar-value .gf-figure { white-space: nowrap; }
        .gf-bars li + li { margin-top: .35rem; }
        .gf-bars li > .gf-cell { grid-column: 1 / -1; }
        .gf-bar-refused { grid-column: 1 / -1; }
    }
    .gf-cell { color: var(--muted, #6e6e73); font-size: .85em; }
    .gf-table { border-collapse: collapse; }
    .gf-table td, .gf-table th { border-bottom: 1px solid var(--line, #e5e5ea); padding: .25rem .75rem .25rem 0; text-align: left; }
    .gf-table th:last-child { text-align: right; }
    .gf-table td.gf-num { text-align: right; }
    .gf-line svg { width: 100%; max-width: 640px; height: auto; overflow: visible; }
    .gf-line .gf-grid { stroke: var(--gf-grid); stroke-width: 1; }
    /* In SVG units: the chart scales down on a narrow screen, so its text starts a little larger. */
    .gf-line .gf-scale, .gf-line .gf-tick { font: 15px system-ui, sans-serif; fill: var(--muted, #6e6e73); font-variant-numeric: tabular-nums; }
    /* The halo of a scale label is a text of its own, under it: the label's dotted underline stays whole. */
    .gf-line .gf-halo { font: 15px system-ui, sans-serif; font-variant-numeric: tabular-nums; fill: var(--gf-surface); stroke: var(--gf-surface); stroke-width: 5px; stroke-linejoin: round; }
    .gf-line a .gf-scale { text-decoration: underline dotted; }
    .gf-line .gf-stroke { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
    .gf-line .gf-dot { stroke: var(--gf-surface); stroke-width: 2; }
    .gf-line a:hover .gf-dot, .gf-line a:focus .gf-dot { r: 6; }
    .gf-stroke.gf-s1 { stroke: var(--gf-s1); } .gf-stroke.gf-s2 { stroke: var(--gf-s2); } .gf-stroke.gf-s3 { stroke: var(--gf-s3); } .gf-stroke.gf-s4 { stroke: var(--gf-s4); }
    .gf-stroke.gf-s5 { stroke: var(--gf-s5); } .gf-stroke.gf-s6 { stroke: var(--gf-s6); } .gf-stroke.gf-s7 { stroke: var(--gf-s7); } .gf-stroke.gf-s8 { stroke: var(--gf-s8); }
    .gf-dot.gf-s1, .gf-swatch.gf-s1 { fill: var(--gf-s1); background: var(--gf-s1); } .gf-dot.gf-s2, .gf-swatch.gf-s2 { fill: var(--gf-s2); background: var(--gf-s2); }
    .gf-dot.gf-s3, .gf-swatch.gf-s3 { fill: var(--gf-s3); background: var(--gf-s3); } .gf-dot.gf-s4, .gf-swatch.gf-s4 { fill: var(--gf-s4); background: var(--gf-s4); }
    .gf-dot.gf-s5, .gf-swatch.gf-s5 { fill: var(--gf-s5); background: var(--gf-s5); } .gf-dot.gf-s6, .gf-swatch.gf-s6 { fill: var(--gf-s6); background: var(--gf-s6); }
    .gf-dot.gf-s7, .gf-swatch.gf-s7 { fill: var(--gf-s7); background: var(--gf-s7); } .gf-dot.gf-s8, .gf-swatch.gf-s8 { fill: var(--gf-s8); background: var(--gf-s8); }
    .gf-legend { list-style: none; padding: 0; margin: .5rem 0 0; display: grid; gap: .25rem; }
    .gf-swatch { display: inline-block; width: .8em; height: .8em; border-radius: 2px; margin-right: .3em; vertical-align: -.05em; }
    /* Parts in a column, except tiles in a row: consecutive tiles sit side by side, as cards. */
    .gf-page, .gf-page > .parts { display: flex; flex-wrap: wrap; column-gap: 1rem; align-items: flex-start; }
    .gf-page > *, .gf-page > .parts > * { flex: 1 1 100%; min-width: 0; }
    .gf-page > .gf-kpi, .gf-page > .parts > .gf-kpi { flex: 1 1 13rem; border: 1px solid var(--line, #e5e5ea); border-radius: 10px; padding: .8rem 1rem; margin-bottom: 1rem; }
    .gf-kpi .gf-heading { font-size: .95rem; font-weight: 600; margin: 0; }
    .gf-kpi p { margin: .35rem 0 0; }
    .gf-kpi .gf-cell { margin-top: .15rem; }
    .gf-credits { color: var(--muted, #6e6e73); font-size: .85em; margin: 0; }
    .gf-credits a { color: inherit; }
    /* Forced colours repaint backgrounds: bars and swatches keep theirs. */
    @media (forced-colors: active) { .gf-bar, .gf-swatch { forced-color-adjust: none; } }
</style>
